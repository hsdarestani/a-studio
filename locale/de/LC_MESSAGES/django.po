msgid "%(name)s workspace"
msgstr "Workspace von %(name)s"

msgid "/month"
msgstr "/Monat"

msgid "20 welcome credits"
msgstr "20 Startguthaben-Credits"

msgid "A clear process instead of technical chaos."
msgstr "Ein klarer Prozess statt technischem Chaos."

msgid "A message is required."
msgstr "Eine Nachricht ist erforderlich."

msgid "A store publishing request was created for %(platform)s. A+ Solution will review eligibility and developer-account requirements."
msgstr "Für %(platform)s wurde eine Anfrage zur Store-Veröffentlichung erstellt. A+ Solution prüft die Eignung und die Anforderungen an die Entwicklerkonten."

msgid "A successful preview build is required before publishing."
msgstr "Vor der Veröffentlichung ist ein erfolgreicher Vorschau-Build erforderlich."

msgid "A+ Solution combines AI development with consultation, quality assurance, hosting and store publishing. When a decision needs human judgment, our team is part of the workflow."
msgstr "A+ Solution verbindet KI-Entwicklung mit Beratung, Qualitätssicherung, Hosting und Store-Veröffentlichung. Sobald eine Entscheidung menschliches Urteilsvermögen erfordert, ist unser Team Teil des Workflows."

msgid "A+ Solution reviews store eligibility, prepares native packages, metadata, screenshots, privacy declarations, testing tracks and submission under the customer's own developer accounts."
msgstr "A+ Solution prüft die Store-Eignung und erstellt native Pakete, Metadaten, Screenshots, Datenschutzerklärungen, Test-Tracks sowie die Einreichung über die eigenen Entwicklerkonten des Kunden."

msgid "A+ Studio product preview"
msgstr "A+ Studio Produktvorschau"

msgid "A+ Studio turns business ideas into production-ready apps with AI development, private source code, managed hosting and human support."
msgstr "A+ Studio verwandelt Geschäftsideen in produktionsreife Apps – mit KI-Entwicklung, privatem Quellcode, Managed Hosting und persönlichem Support."

msgid "A+ Studio — AI-powered app development by A+ Solution GmbH."
msgstr "A+ Studio – KI-gestützte App-Entwicklung von A+ Solution GmbH."

msgid "A+ human support"
msgstr "Persönlicher A+ Support"

msgid "A+ service"
msgstr "A+ Service"

msgid "AI APP DEVELOPMENT · MADE IN GERMANY"
